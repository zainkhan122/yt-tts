  "motion": [
   "panlr",
   1.22,
   1.22,
   0.0,
   0.5,
   1.0,
   0.5
  ],
  "caption": null,
  "cap_start": 0.0,
  "beat_len": 6.033333333333333,
  "beat_dur": 6.033333333333333,
  "v_dur": 6.03
 },
 {
  "sentence": "For six years, he withdrew.",
  "asset": "sv18",
  "motion": [
   "diag",
