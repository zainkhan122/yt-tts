[2026-09-01 03:46:10] [INFO] API Gateway RAW Response [prov_1779643665_n0pte]: {"id":"gen-1788234333-LtRyRHFyyndB21Iv6P9I","object":"chat.completion","created":1788234333,"model":"minimax/minimax-m3:free","provider":"GMICloud","system_fingerprint":null,"service_tier":null,"choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"stop","message":{"role":"assistant","content":"{\"title\": \"SageThumbs 2K 2.5.0 Download for Windows (Nov 2025)\",\"meta_description\": \"SageThumbs 2K brings native File Explorer thumbnail previews for RAW, PSD, HEIC, AVIF, and hundreds of other formats on Windows 10 and 11 — free, open source, and lightweight.\",\"slug\": \"sagethumbs-2k\",\"focus_keyword\": \"SageThumbs 2K\",\"long_tail_keywords\":[\"SageThumbs 2K Windows 11 64-bit\",\"SageThumbs 2K portable\",\"SageThumbs 2K 2.5.0 2025\"],\"needs_manual_input\":[\"tech_specs.homepage\",\"system_requirements.minimum.os\"],\"keyword_variations\":[\"download SageThumbs 2K\",\"get SageThumbs 2K\",\"SageThumbs 2K installer\",\"SageThumbs 2K for Windows\"],\"introduction\":[\"SageThumbs 2K is the modern successor to the classic SageThumbs shell extension, rebuilt from the ground up for today's Windows. It's a lightweight File Explorer add-on that finally gives Windows 10 and Windows 11 the ability to show thumbnails for file types Microsoft left behind — RAW photos from your camera, layered Photoshop PSDs, HEIC images off your iPhone, AVIF and JPEG XL files, DDS textures, OpenEXR HDR renders, ebooks, CAD drawings, 3D assets, audio waveforms, and plenty of video formats too.\",\"Instead of opening a dedicated viewer just to figure out what a file actually is, you get a real preview right inside Explorer. For photographers sorting through hundreds of RAW shots, designers flipping through PSD comps, or anyone managing a mixed library of modern media, that difference adds up fast. It's the same familiar idea behind the original SageThumbs — just brought up to date with a refreshed codebase and vastly broader format coverage.\"],\"tech_specs\":{\"software_name\":\"SageThumbs 2K\",\"file_name\":\"SageThumbs2K-Setup-2.5.0.exe\",\"version\":\"2.5.0\",\"license\":\"Open Source\",\"developer\":\"LunarWerxs\",\"homepage\":\"https://sagethumbs2k.github.io/\",\"changelogurl\":\"https://github.com/LunarWerxs/SageThumbs-2k/releases\",\"file_size\":\"20.0 MB\",\"os_support\":\"Windows 10, Windows 11\",\"language_support\":\"English\",\"last_updated\":\"2025\"},\"features\":[{\"name\":\"Massive Format Coverage\",\"description\":\"SageThumbs 2K adds Explorer thumbnail support for hundreds of formats Windows can't display natively, including RAW camera files, Photoshop PSD, HEIC, AVIF, JPEG XL (JXL), DDS, EXR, ebooks, comics, CAD files, 3D assets, audio, and many video containers. Browsing mixed media libraries no longer means opening a separate viewer for every unknown extension.\"},{\"name\":\"Native File Explorer Integration\",\"description\":\"The extension hooks directly into Windows File Explorer as a shell extension, so thumbnails appear automatically in the Details, Large Icons, and Extra Large Icons views. Once it's installed, large folders of unsupported files become browsable the same way JPEG folders always have been.\"},{\"name\":\"Lightweight and Stable\",\"description\":\"SageThumbs 2K was rebuilt with a modernized codebase focused on speed, stability, and low resource use. It stays out of the way while Explorer is idle and only kicks in when a folder containing supported formats is opened.\"},{\"name\":\"Thumbnail Corner Customization\",\"description\":\"A single Appearance option replaces the old pair of confusing icon settings. You can pick the default Windows file-type icon, a SageThumbs format badge (like PSD, JXL, or AVIF) so file types are recognizable at a glance, or no icon at all for a clean look.\"},{\"name\":\"Portable Build\",\"description\":\"A no-installer ZIP is offered alongside the standard setup. Extract it and run the executable — nothing gets written to the registry, no admin rights are needed, and settings are saved to a SageThumbs2K.ini file beside the app.\"},{\"name\":\"Right-Click Context Menu\",\"description\":\"Beyond thumbnails, the installed build adds useful right-click options in Explorer for supported file types, giving quick access to conversion and other tools without launching a separate program first.\"},{\"name\":\"Open Source and Free\",\"description\":\"SageThumbs 2K is released as open source, with the full project hosted on GitHub. Both x64 and ARM64 installers are available, along with matching portable builds for each architecture.\"}],\"whats_new\":[\"Optional sign-in reminders: Settings may show a small suggestion to sign in with a Connections account so settings can be carried across multiple machines. The reminder is limited to once per day, can be dismissed, and signing in remains completely optional.\",\"The installer now asks for this preference during a fresh installation, while upgrades preserve the previous configuration.\",\"More reliable EPS thumbnails: More EPS files now display thumbnails because SageThumbs correctly handles files containing a blank line after the embedded preview header. EPS files without an embedded preview still cannot be rendered, since SageThumbs deliberately does not execute PostScript.\",\"Correct Quick Preview tooltips: Button tooltips now dynamically reflect the action that will happen when clicked. This fixes incorrect descriptions for Light/Dark mode, Pin, View Source, Mute, and Repeat buttons.\",\"Improved plain-text email preview: Lines beginning with # in plain-text emails are no longer incorrectly interpreted as document headings. They now appear as normal text instead of being enlarged and added to the preview's outline. Quoted replies and numbered lists continue to be formatted correctly.\",\"New thumbnail corner customization: the two confusing thumbnail-icon settings have been replaced with a single Appearance option — Windows file-type icon (default), SageThumbs format badge (e.g. PSD, JXL, AVIF), or No icon.\"],\"system_requirements\":{\"minimum\":{\"os\":\"Windows 10\",\"processor\":null,\"ram\":null,\"disk_space\":null,\"graphics\":null},\"recommended\":{\"os\":\"Windows 11\",\"processor\":null,\"ram\":null,\"disk_space\":null},\"_note\":\"The official page does not list explicit minimum or recommended hardware. SageThumbs 2K supports Windows 10 and Windows 11.\"},\"faqs\":[{\"question\":\"Is SageThumbs 2K free to use?\",\"answer\":\"Yes. SageThumbs 2K is released as open source and is free to download and use. Both the standard installer and the portable build are offered at no cost.\"},{\"question\":\"Does SageThumbs 2K work on Windows 11?\",\"answer\":\"Yes. SageThumbs 2K was rebuilt specifically for current versions of Windows, including Windows 10 and Windows 11. Separate x64 and ARM64 installers are available, so it works on both Intel and Snapdragon-based PCs.\"},{\"question\":\"What is the difference between the installer and the portable build?\",\"answer\":\"The installer registers the shell extension with Windows, which is required for File Explorer integration and the right-click context menu. The portable build needs no installation and leaves no registry entries, but because Windows only loads shell extensions whose COM classes are registered, the portable version cannot provide Explorer thumbnails or the right-click menu.\"}],\"installation_guide\":{\"steps\":[\"Step 1: Click the download button above to get the installer for your operating system (x64 or ARM64).\",\"Step 2: Locate the downloaded file and double-click it to launch the setup program.\",\"Step 3: Follow the on-screen installation wizard to complete setup. A fresh install will prompt you about the optional Connections sign-in; upgrades keep the previous preference.\",\"Step 4: Restart File Explorer or sign out and back in so Windows picks up the newly registered shell extension.\",\"Step 5: Open any folder containing RAW, PSD, HEIC, AVIF, or other supported files and switch to a thumbnail view to confirm previews are rendering.\"],\"compatibility_notes\":\"Compatible with Windows 10 and Windows 11. x64 and ARM64 installers are published separately, each with a matching portable ZIP. The portable build does not provide Explorer thumbnails or the right-click context menu because Windows shell extensions require a registered COM class.\",\"common_issues\":[\"Issue: Thumbnails don't appear after install → Solution: Restart File Explorer (or sign out and back in) so Windows reloads the shell extension.\",\"Issue: Portable build shows no thumbnails in Explorer → Expected behavior. Windows shell extensions must be installed to register the COM class; install the standard build if you need Explorer integration.\",\"Issue: EPS files still don't preview → Expected. SageThumbs deliberately does not execute PostScript, so only EPS files with an embedded preview header can be thumbnailed.\"]},\"tags\":[\"sagethumbs2k\",\"freeware\",\"windowsshell\",\"thumbnailviewer\"],\"_tags_note\":\"Single-token tags only: sagethumbs2k (software), freeware (license), windowsshell (subtype), thumbnailviewer (function).\",\"software_type\":\"SIMPLE_UTILITY\",\"moat_data\":{}}","refusal":null,"reasoning":null}}],"usage":{"prompt_tokens":9213,"completion_tokens":1865,"total_tokens":11078,"cost":0,"is_byok":false,"prompt_tokens_details":{"cached_tokens":128,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0,"upstream_inference_prompt_cost":0,"upstream_inference_completions_cost":0},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}
