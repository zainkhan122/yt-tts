   1.0,
   0.5,
   0.0,
   0.5
  ],
  "caption": null,
  "cap_start": 0.0,
  "beat_len": 3.6333333333333333,
  "beat_dur": 3.6333333333333333,
  "v_dur": 3.63
 },
 {
  "sentence": "What if the loneliness you feel isn't a sign that you're failing to connect \u2014 but a sign that you're finally becoming yourself?",
