   "gold"
  ],
  "cap_start": 5.859,
  "beat_len": 7.333333333333333,
  "beat_dur": 7.333333333333333,
  "v_dur": 7.33
 },
 {
  "sentence": "Because one of the greatest minds in psychology discovered this a hundred years ago.",
  "asset": "img04",
  "motion": [
   "zin",
   1.0,
   1.38,
   0.5,
   0.5,
   0.5,
   0.5
  ],
  "caption": null,
  "cap_start": 0.0,
  "beat_len": 5.133333333333334,
  "beat_dur": 5.133333333333334,
  "v_dur": 5.13
 },
 {
  "sentence": "And he paid for it with six years of almost complete isolation.",
  "asset": "sp18",
  "motion": [
   "settle",
   1.45,
   1.0,
   0.5,
   0.5,
   0.5,
   0.5
  ],
