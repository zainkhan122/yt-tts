  "beat_len": 4.033333333333333,
  "beat_dur": 4.033333333333333,
  "v_dur": 4.03
 },
 {
  "sentence": "We think borrowed thoughts, feel borrowed feelings, want borrowed wants \u2014 inherited from our family, our culture, our crowd.",
