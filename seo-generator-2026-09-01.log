[2026-09-01 03:49:39] [INFO] API Gateway RAW Response [prov_1779643665_n0pte]: {"id":"gen-1788234550-h4M45LlGiUc9CdBgzxAV","object":"chat.completion","created":1788234550,"model":"minimax/minimax-m3:free","provider":"GMICloud","system_fingerprint":null,"service_tier":null,"choices":[{"index":0,"logprobs":null,"finish_reason":"stop","native_finish_reason":"stop","message":{"role":"assistant","content":"{\"title\":\"SageThumbs 2K 2.5.0 Download for Windows (Open Source)\",\"meta_description\":\"SageThumbs 2K is a free, open-source Windows shell extension that adds Explorer thumbnail previews for RAW, PSD, HEIC, AVIF, JXL and hundreds more. Grab the installer today.\",\"slug\":\"sagethumbs-2k\",\"focus_keyword\":\"SageThumbs 2K\",\"long_tail_keywords\":[\"SageThumbs 2K Windows 11\",\"SageThumbs 2K portable\",\"SageThumbs 2K ARM64\",\"SageThumbs 2K 2.5.0 2025\"],\"needs_manual_input\":[\"tech_specs.homepage\",\"system_requirements.minimum.os\"],\"keyword_variations\":[\"download SageThumbs 2K\",\"get SageThumbs 2K\",\"SageThumbs 2K installer\",\"SageThumbs 2K for Windows 11\"],\"introduction\":[\"**SageThumbs 2K** is the modern successor to the classic SageThumbs shell extension, rebuilt from the ground up to bring thumbnail previews to Windows 10 and Windows 11 File Explorer for hundreds of formats that the OS still refuses to display natively. RAW photographs from your camera, layered Photoshop PSD files, HEIC shots from an iPhone, AVIF and JPEG XL web images, DDS textures, OpenEXR HDR renders, ebook chapters, comic book pages, CAD drawings, 3D assets, audio files, and even many video formats now show up as proper thumbnails instead of generic icons.\",\"Where earlier Explorer thumbnail tools were narrow in scope, **SageThumbs 2K** goes wide without getting heavy. It plugs directly into the shell so browsing a folder feels native, thumbnails generate quickly, and you stop launching separate viewers just to figure out which file is which. Photographers, designers, developers, and anyone who manages mixed media libraries get a noticeably more useful Explorer as a result.\"],\"tech_specs\":{\"software_name\":\"SageThumbs 2K\",\"file_name\":\"SageThumbs2K-Setup-2.5.0.exe\",\"version\":\"2.5.0\",\"license\":\"Open Source\",\"developer\":\"LunarWerxs\",\"homepage\":\"https://sagethumbs2k.github.io/\",\"changelogurl\":\"https://github.com/LunarWerxs/SageThumbs-2k/releases/tag/v2.5.0\",\"file_size\":\"20.0 MB\",\"os_support\":\"Windows 11, Windows 10\",\"language_support\":\"English\",\"last_updated\":\"2025\"},\"features\":[{\"name\":\"Broad Format Coverage\",\"description\":\"**SageThumbs 2K** generates Explorer thumbnails for RAW camera images, PSD, HEIC, AVIF, JPEG XL (JXL), DDS, EXR, ebooks, comics, CAD files, 3D assets, audio, and many video formats, replacing generic icons with real previews.\"},{\"name\":\"Native File Explorer Integration\",\"description\":\"Installs as a lightweight shell extension so previews appear directly inside Windows File Explorer on Windows 10 and 11, without launching any separate viewer or background process window.\"},{\"name\":\"Thumbnail Corner Customization\",\"description\":\"A single Appearance option replaces the old pair of confusing icon toggles, letting you pick a Windows file-type icon, a SageThumbs format badge such as JXL or PSD, or no icon at all.\"},{\"name\":\"Portable Build Available\",\"description\":\"A no-installer portable archive ships alongside the standard setup. Extract it, run the executable, and settings are stored in a SageThumbs2K.ini file next to the binary with no registry writes or admin rights needed.\"},{\"name\":\"Faster RAW and PSD Browsing\",\"description\":\"RAW photo libraries and layered Photoshop PSD folders now render previews inside Explorer, dramatically speeding up culling, sorting, and visual review workflows for photographers and designers.\"},{\"name\":\"EPS Preview Handling\",\"description\":\"More EPS files display thumbnails because the embedded preview header parsing is more tolerant, while files with no embedded preview remain unrendered since PostScript is never executed.\"},{\"name\":\"Modernized Codebase\",\"description\":\"The original SageThumbs idea is preserved but the underlying code is refreshed for current Windows builds, improving stability, compatibility, and long-term support on modern hardware including Snapdragon X ARM64 devices.\"}],\"whats_new\":[\"Optional sign-in reminders for syncing settings across multiple machines, limited to once per day and fully dismissable.\",\"Fresh installs now ask about the Connections sign-in preference during setup, while upgrades keep the previous configuration.\",\"More EPS files display thumbnails thanks to better handling of blank lines after the embedded preview header.\",\"Quick Preview button tooltips correctly reflect the action they perform, fixing inaccurate descriptions for Light/Dark mode, Pin, View Source, Mute, and Repeat buttons.\",\"Plain-text email preview no longer treats lines starting with # as headings, preserving quoted replies and numbered lists.\",\"Two legacy thumbnail-icon settings merged into a single Appearance option that lets you pick the Windows file-type icon, a SageThumbs format badge like PSD or JXL, or no icon at all.\"],\"system_requirements\":{\"minimum\":{\"os\":\"Windows 10 or Windows 11\",\"processor\":null,\"ram\":null,\"disk_space\":null,\"graphics\":null},\"recommended\":{\"os\":\"Windows 11 (64-bit)\",\"processor\":null,\"ram\":null,\"disk_space\":null},\"_note\":\"The official page does not list explicit CPU, RAM, disk, or GPU requirements. Only the supported operating systems are confirmed.\"},\"faqs\":[],\"installation_guide\":{\"steps\":[\"Step 1: Click the download button above and choose either the standard installer or the portable archive.\",\"Step 2: For the installer, double-click SageThumbs2K-Setup-2.5.0.exe and grant administrator permission when prompted.\",\"Step 3: Follow the on-screen wizard, accept the license, and finish the setup.\",\"Step 4: For the portable build, extract SageThumbs2K-Portable-2.5.0.zip to any folder and run SageThumbs2K.exe from there; settings will be saved next to the executable.\",\"Step 5: Open File Explorer and navigate to a folder containing RAW, PSD, HEIC, or other supported files to confirm that thumbnails are being generated.\"],\"compatibility_notes\":\"Supports Windows 10 and Windows 11 on both x64 and ARM64 architectures. ARM64 users should download the SageThumbs2K-Setup-2.5.0-arm64.exe installer or the matching portable ZIP. The portable build does not register the shell extension, so it will not produce Explorer thumbnails or the right-click context menu — install the standard build for that functionality.\",\"common_issues\":[\"Issue: Thumbnails do not appear in Explorer → Solution: Make sure you installed the standard build rather than the portable archive, then restart Explorer or sign out and back in.\",\"Issue: ARM64 device installs the wrong architecture → Solution: Use the dedicated ARM64 installer or portable ZIP from the GitHub releases page.\",\"Issue: EPS files still show no thumbnail → Solution: The file likely has no embedded preview header; SageThumbs does not execute PostScript and cannot render those files.\",\"Issue: Settings were lost after switching machines → Solution: Sign in with a Connections account from Settings so preferences can be carried across devices.\"]},\"tags\":[\"thumbnailviewer\",\"freeware\",\"windows\",\"shell-extension\"],\"software_type\":\"SIMPLE_UTILITY\",\"moat_data\":{}}","refusal":null,"reasoning":null}}],"usage":{"prompt_tokens":9213,"completion_tokens":1536,"total_tokens":10749,"cost":0,"is_byok":false,"prompt_tokens_details":{"cached_tokens":9212,"cache_write_tokens":0,"audio_tokens":0,"video_tokens":0},"cost_details":{"upstream_inference_cost":0,"upstream_inference_prompt_cost":0,"upstream_inference_completions_cost":0},"completion_tokens_details":{"reasoning_tokens":0,"image_tokens":0,"audio_tokens":0}}}
