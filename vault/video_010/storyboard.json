   "SIX YEARS ALONE",
   "pop"
  ],
  "cap_start": 1.4,
  "beat_len": 4.466666666666667,
  "beat_dur": 4.466666666666667,
  "v_dur": 4.47
 },
 {
  "sentence": "Let me start with Carl Jung.",
  "asset": "img03",
  "motion": [
   "panlr",
   1.22,
   1.22,
   0.0,
   0.5,
   1.0,
   0.5
  ],
  "caption": null,
  "cap_start": 0.0,
  "beat_len": 1.9,
  "beat_dur": 1.9,
  "v_dur": 1.9
 },
 {
  "sentence": "In 1913, at the height of his career, Jung broke with his mentor, Sigmund Freud.",
  "asset": "img06",
  "motion": [
   "diag",
   1.04,
   1.34,
   0.15,
   0.2,
   0.75,
   0.55
  ],
  "caption": null,
  "cap_start": 0.0,
  "beat_len": 6.033333333333333,
  "beat_dur": 6.033333333333333,
  "v_dur": 6.03
 },
 {
  "sentence": "It was the most important relationship of his professional life.",
  "asset": "sp43",
  "motion": [
   "zout",
   1.3,
   1.02,
   0.5,
   0.5,
   0.5,
   0.5
  ],
  "caption": null,
  "cap_start": 0.0,
  "beat_len": 3.7,
  "beat_dur": 3.7,
  "v_dur": 3.7
 },
 {
  "sentence": "And when it shattered, Jung fell into a period that would have looked, from the outside, like madness.",
